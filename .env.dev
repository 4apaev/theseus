# test-suited overrides, stacked on top of .env by scripts/test.sh
# and npm run smoke (later --env-file wins; real env beats both)

# gateway skips its per-request log line in test - see routes.js
NODE_ENV=test

# shrink travel: sol.outpost → barnards.port = 6.0 ly / 0.6c ≈ 1s
TIME_SCALE=0.1

# outbox rows publish almost immediately - specs wait on outbox-relayed
# events constantly, the 1s production default dominates integration time
OUTBOX_INTERVAL=25

# same reasoning for ship arrival polling - specs wait on ship.arrived
SHIP_ARRIVAL_INTERVAL=25

# market drift fires once, right away, every time (see drift.js).
# integration tests and smoke check exact stock and price values.
# drift stays off here. its unit tests live in market.spec.js.
MARKET_DRIFT_INTERVAL=0

JWT_SECRET=hush-hush

# integration tests + smoke run against their own database, dropped and
# recreated from scratch every run by scripts/reset-test-db.js - never
# points at the real theseus db (that script hard-refuses otherwise)
PG_DB=theseus_test
